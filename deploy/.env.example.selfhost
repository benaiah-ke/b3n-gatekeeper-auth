APP_ENV=production
APP_VERSION=0.1.0
DEBUG=false
GATEKEEPER_API_IMAGE=gatekeeper-api
GATEKEEPER_UI_IMAGE=gatekeeper-ui
GATEKEEPER_IMAGE_TAG=latest
GATEKEEPER_URL=https://auth.example.com
UI_URL=https://auth.example.com
CORS_ORIGINS=https://auth.example.com
WEBAUTHN_RP_ID=auth.example.com
WEBAUTHN_RP_NAME=GateKeeper
WEBAUTHN_ORIGINS=https://auth.example.com
WEBAUTHN_CHALLENGE_TTL_SECONDS=300

DATABASE_URL=postgresql+asyncpg://gatekeeper:change-me@gatekeeper-postgres:5432/gatekeeper
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300
POSTGRES_DB=gatekeeper
POSTGRES_USER=gatekeeper
POSTGRES_PASSWORD=change-me

SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_KEY_DIR=/data/keys
JWT_KEY_ID=gatekeeper-prod
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
DEVICE_CODE_TTL_SECONDS=600
EMAIL_CODE_TTL_SECONDS=900

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ORG_NAME=Example Org
BOOTSTRAP_ORG_SLUG=example

# Registration: closed (default) lets only admin provisioning or SCIM create accounts;
# invite also lets a valid invitation create one. Signup only creates the first owner.
SIGNUP_MODE=closed
# GateKeeper API accepts only tokens for this audience or the issuer (GATEKEEPER_URL).
GATEKEEPER_API_AUDIENCE=gatekeeper-api
# Platform admins: active owners of the bootstrap org plus these comma-separated user IDs.
PLATFORM_ADMIN_USER_IDS=
# Only platform admins may create or change OAuth clients for these audiences.
RESERVED_AUDIENCES=gatekeeper-api,sentinel-api,knowhere-api,devsync,woodpecker
# Proxy CIDRs whose X-Forwarded-For / CF-Connecting-IP headers are trusted. Empty trusts nothing.
TRUSTED_PROXY_CIDRS=

# Security alert emails through Sendy. Alerts stay off until the key and recipient are set.
SENDY_API_KEY=
SENDY_API_URL=https://usesendy.com
ALERT_EMAIL_FROM=B3n Alerts <alerts@notification.b3n.in>
ALERT_EMAIL_TO=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=GateKeeper <auth@example.com>
SMTP_USE_TLS=true
EMAIL_DEV_MODE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://auth.example.com/api/v1/auth/oauth/google/callback
OAUTH_PROVIDERS_JSON=

ENABLE_DYNAMIC_CLIENT_REGISTRATION=false
MCP_DEFAULT_SCOPES=mcp:tools,mcp:resources

COOKIE_NAME=gk_session
REFRESH_COOKIE_NAME=gk_refresh
DEVICE_COOKIE_NAME=gk_device
COOKIE_SECURE=true
COOKIE_DOMAIN=

TLS_EMAIL=admin@example.com
DEFAULT_DOMAIN=auth.example.com
GATEKEEPER_ENV_FILE=.env
